# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of authorized Telegram user IDs (leave empty to allow all)
TELEGRAM_ALLOWED_USER_IDS=123456789

# Printer (USB IDs for Epson TM-P80)
PRINTER_VENDOR_ID=0x04b8
PRINTER_PRODUCT_ID=0x0e20
PRINTER_PROFILE=TM-P80

# Web interface port
WEB_PORT=8080

# Path to settings file (inside container: /app/config/settings.json)
CONFIG_PATH=config/settings.json
