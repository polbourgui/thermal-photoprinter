# Epson TM-M30 USB IDs
PRINTER_VENDOR_ID=0x04b8
PRINTER_PRODUCT_ID=0x0e02
PRINTER_PROFILE=TM-m30

# Web interface port (accessible via Tailscale)
WEB_PORT=8080

# Path to settings file
CONFIG_PATH=config/settings.json

# Shotgun.live API token (generate from Smartboard > Settings > Integrations > Shotgun APIs)
# Leave empty to disable Shotgun integration
SHOTGUN_API_TOKEN=
